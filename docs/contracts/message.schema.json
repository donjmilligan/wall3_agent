{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wall3-agent:contracts:message",
  "title": "Message",
  "description": "One normalized Slack or ClickUp message, as emitted (one per line, JSONL) by `bin/slack ... --json` and `bin/clickup ... --json`. The whoami shape is in $defs/whoami.",
  "$ref": "#/$defs/message",
  "$defs": {
    "source": {
      "enum": ["slack", "clickup"]
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "slackRef": {
      "description": "<channel_id>:<ts>, e.g. C123ABC:1730729002.123456",
      "type": "string",
      "pattern": "^[A-Z0-9]+:[0-9]+\\.[0-9]+$"
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": {"enum": ["channel", "dm", "mpim", "task", "chat"]},
        "id": {"$ref": "#/$defs/nonEmpty"},
        "name": {"type": "string"}
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "name": {"type": "string"}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "id",
        "thread_id",
        "container",
        "author",
        "ts",
        "text",
        "permalink",
        "is_mention",
        "is_dm",
        "awaiting_reply"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "id": {
          "description": "slack: <channel_id>:<ts>. clickup: comment id or chat message id.",
          "$ref": "#/$defs/nonEmpty"
        },
        "thread_id": {
          "description": "slack: <channel_id>:<thread_ts>. clickup: task id (task comments) or parent chat message id. null when not in a thread.",
          "anyOf": [{"$ref": "#/$defs/nonEmpty"}, {"type": "null"}]
        },
        "container": {"$ref": "#/$defs/container"},
        "author": {"$ref": "#/$defs/author"},
        "ts": {
          "description": "ISO-8601 UTC with a Z suffix and whole seconds, e.g. 2026-11-04T14:03:22Z, so string order is time order.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "text": {
          "description": "Plain text; user mentions rendered as @name where resolvable.",
          "type": "string"
        },
        "permalink": {"type": "string", "pattern": "^https?://\\S+$"},
        "is_mention": {"type": "boolean"},
        "is_dm": {"type": "boolean"},
        "awaiting_reply": {
          "description": "The last message in its thread is not from me AND it DMs or mentions me.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "slack"}}},
          "then": {
            "properties": {
              "id": {"$ref": "#/$defs/slackRef"},
              "thread_id": {"anyOf": [{"$ref": "#/$defs/slackRef"}, {"type": "null"}]},
              "container": {"properties": {"kind": {"enum": ["channel", "dm", "mpim"]}}}
            }
          }
        },
        {
          "if": {"properties": {"source": {"const": "clickup"}}},
          "then": {
            "properties": {
              "container": {"properties": {"kind": {"enum": ["task", "chat"]}}}
            }
          }
        }
      ]
    },
    "whoami": {
      "description": "`whoami --json` output.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "name"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "id": {"$ref": "#/$defs/nonEmpty"},
        "name": {"type": "string"}
      }
    }
  }
}
