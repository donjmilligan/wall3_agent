# Copy the line below into the PRIMARY checkout's .env (repo root), not a
# worktree's: .env is gitignored, so worktrees never get one, and this client
# finds the primary checkout's automatically.
#
# The value is the "User OAuth Token" (starts with xoxp-) from your Slack app's
# OAuth & Permissions page. Never commit it, paste it into chat, or log it.
SLACK_USER_TOKEN=xoxp-REPLACE-ME
