# Copy to .env (gitignored) and fill in. Never commit real values.
# The CLIs read these; the SessionStart hook reports which are set, by name only.

# Slack user OAuth token (starts with xoxp-). Create the Slack app from the
# manifest in clients/slack/, install it to your workspace, then copy
# "User OAuth Token" from the app's OAuth & Permissions page.
SLACK_USER_TOKEN=

# ClickUp personal API token (starts with pk_). ClickUp > Settings > Apps >
# API Token > Generate.
CLICKUP_API_TOKEN=

# ClickUp workspace (team) id: the number after app.clickup.com/ in any
# workspace URL, or `bin/clickup whoami --json` once the token is set.
CLICKUP_TEAM_ID=
